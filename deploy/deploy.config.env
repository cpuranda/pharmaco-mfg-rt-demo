# =============================================================================
# Deployment configuration — PharmaCo Manufacturing Real-Time demo
# =============================================================================
# EDIT the values in the "TARGET WORKSPACE" section for the workspace you are
# deploying INTO, then run:  deploy/deploy.sh all
#
# The values pre-filled below are from the original reference deployment; change
# them so you do not point at someone else's workspace. Nothing secret lives here
# (the Zerobus SP OAuth secret goes into a Databricks secret scope at deploy time).
#
# Discovered values (Lakebase DNS, app SP, endpoint names, job id, Genie space id)
# are written by the orchestrator to deploy/.deploy.state.env and merged on re-run.
# =============================================================================

# ---------------------------- TARGET WORKSPACE -------------------------------
# Databricks CLI profile that is authenticated to the TARGET workspace.
DBX_PROFILE=fe-vm-hls-streaming-solution-demo
DBX_WORKSPACE_URL=https://fevm-hls-streaming-solution-demo.cloud.databricks.com
DBX_WORKSPACE_ID=7474651570340482
DBX_REGION=us-east-1
# An existing serverless SQL warehouse in the target workspace (id).
DBX_WAREHOUSE_ID=1b3fb1ab4eaa9511
# Workspace user (or SP) whose /Workspace/Users/<email> path hosts the app + notebook.
APP_USER_EMAIL=chandrashekhar.purandare@databricks.com

# ---------------------------- UC NAMESPACE -----------------------------------
DEMO_CATALOG=hls_streaming_solution_demo_catalog
DEMO_BRONZE=pharmaco_mfg_rt_bronze
DEMO_SILVER=pharmaco_mfg_rt_silver
DEMO_GOLD=pharmaco_mfg_rt_gold
DEMO_KNOWLEDGE_SCHEMA=pharmaco_mfg_rt_knowledge
DEMO_LDP_SCHEMA=pharmaco_mfg_rt_ldp
BRONZE_TABLE=telemetry_raw
CHECKPOINT_VOLUME=/Volumes/${DEMO_CATALOG}/${DEMO_BRONZE}/checkpoints

# ---------------------------- ZEROBUS / SP -----------------------------------
# Service principal (ingest identity). Create one in the target workspace and put
# its application (client) id here; its OAuth secret is stored in the secret scope.
DEMO_SP_CLIENT_ID=3663de8f-6de6-4c10-adf5-5ba7946eefed
ZB_CLIENT_ID=3663de8f-6de6-4c10-adf5-5ba7946eefed
SECRET_SCOPE=pharmaco_mfg_rt_demo
SECRET_KEY=sp_oauth_secret
# Zerobus endpoint is derived from workspace id + region (usually correct):
ZB_ENDPOINT=https://${DBX_WORKSPACE_ID}.zerobus.${DBX_REGION}.cloud.databricks.com

# ---------------------------- LAKEBASE ---------------------------------------
LAKEBASE_INSTANCE=pharmaco-mfg-rt-demo-lb
LAKEBASE_DB=databricks_postgres
LAKEBASE_APP_DB=pharmaco_mfg_rt          # Postgres schema the app uses (PG_SCHEMA).
                                         # Keep as-is unless you also edit lakebase/schema.sql,
                                         # which hardcodes this schema name.
# LAKEBASE_DNS is discovered from the instance at deploy time (leave blank to auto-fill).
LAKEBASE_DNS=

# ---------------------------- AI / AGENTS ------------------------------------
ASSISTANT_LLM_ENDPOINT=databricks-claude-sonnet-4-5   # any llm/v1/chat endpoint
EMBED_ENDPOINT=databricks-gte-large-en                # embeddings for Vector Search
VS_ENDPOINT=pharmaco-mfg-rt-vs                        # Vector Search endpoint name
KA_NAME=pharmaco-mfg-sop-ka                           # Knowledge Assistant display name
SUPERVISOR_NAME=pharmaco-mfg-supervisor               # Multi-Agent Supervisor display name
# Genie space id over the 4 gold tables. Create/curate it in the target workspace
# and set it here (or leave blank to skip Genie wiring; the supervisor still runs SOP-only).
GENIE_SPACE_ID=

# ---------------------------- APP + JOB --------------------------------------
APP_NAME=pharmaco-mfg-rt-demo
STREAMING_JOB_NAME=pharmaco_mfg_rt_streaming
