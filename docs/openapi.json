      "anyOf": [
       {
        "type": "integer",
        "maximum": 3600.0,
        "minimum": 5.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Anomaly Secs"
     },
     "confirm_high_impact": {
      "type": "boolean",
      "title": "Confirm High Impact",
      "default": false
     },
     "operator": {
      "type": "string",
      "title": "Operator",
      "default": "operator"
     }
    },
    "type": "object",
    "required": [
     "scenario"
