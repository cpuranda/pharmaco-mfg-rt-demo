      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sensor Type"
     },
     "alert_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Alert Type"
     },
     "severity": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Severity"
     },
     "observed_value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Observed Value"
     },
     "threshold_value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Threshold Value"
     },
     "anomaly_score": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Anomaly Score"
     },
     "condition": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Condition"
     }
    },
    "type": "object",
    "title": "AlertContext"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ResolveBody": {
    "properties": {
     "operator": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "title": "Operator"
     },
     "note": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     },
     "maintenance": {
      "type": "boolean",
      "title": "Maintenance",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "operator"
    ],
    "title": "ResolveBody"
   },
   "RunBody": {
    "properties": {
