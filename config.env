# Central configuration for the PharmaCo MFG RT demo.
# Source this file (set -a; . config.env; set +a) before running local drivers.
# NOTHING SENSITIVE lives here — the SP OAuth secret is in the secret scope.

# --- Databricks workspace ---
DBX_PROFILE=fe-vm-hls-streaming-solution-demo
DBX_WORKSPACE_URL=https://fevm-hls-streaming-solution-demo.cloud.databricks.com
DBX_WORKSPACE_ID=7474651570340482
DBX_REGION=us-east-1
DBX_WAREHOUSE_ID=1b3fb1ab4eaa9511

# --- Unity Catalog namespace (isolated demo) ---
DEMO_CATALOG=hls_streaming_solution_demo_catalog
DEMO_BRONZE=pharmaco_mfg_rt_bronze
DEMO_SILVER=pharmaco_mfg_rt_silver
DEMO_GOLD=pharmaco_mfg_rt_gold
DEMO_LDP_SCHEMA=pharmaco_mfg_rt_ldp
DEMO_ML_SCHEMA=pharmaco_mfg_rt_ml
DEMO_KNOWLEDGE_SCHEMA=pharmaco_mfg_rt_knowledge
BRONZE_TABLE=telemetry_raw
CHECKPOINT_VOLUME=/Volumes/hls_streaming_solution_demo_catalog/pharmaco_mfg_rt_bronze/checkpoints

# --- Zerobus Ingest ---
ZB_ENDPOINT=https://7474651570340482.zerobus.us-east-1.cloud.databricks.com
ZB_CLIENT_ID=3663de8f-6de6-4c10-adf5-5ba7946eefed
# ZB_CLIENT_SECRET is NOT stored here. Load it at runtime from the secret scope:
#   export ZB_CLIENT_SECRET=$(databricks secrets get-secret pharmaco_mfg_rt_demo sp_oauth_secret \
#     -p "$DBX_PROFILE" -o json | python3 -c "import sys,json,base64;print(base64.b64decode(json.load(sys.stdin)['value']).decode())")

# --- Service principal (demo ingest identity) ---
DEMO_SP_CLIENT_ID=3663de8f-6de6-4c10-adf5-5ba7946eefed
DEMO_SP_ID=78227860470525
SECRET_SCOPE=pharmaco_mfg_rt_demo

# --- Lakebase ---
LAKEBASE_INSTANCE=pharmaco-mfg-rt-demo-lb
LAKEBASE_DNS=
LAKEBASE_DB=databricks_postgres
LAKEBASE_APP_DB=pharmaco_mfg_rt

# --- AI / agents / app ---
VS_ENDPOINT=pharmaco-mfg-rt-vs
EMBED_ENDPOINT=databricks-gte-large-en
ASSISTANT_LLM_ENDPOINT=databricks-claude-sonnet-4-5
APP_NAME=pharmaco-mfg-rt-demo
WS_REPO_DIR=/Workspace/Users/chandrashekhar.purandare@databricks.com/pharmaco_mfg_rt_demo
